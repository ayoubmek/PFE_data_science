# ==============================================================================
# Nexora Intelligent Platform - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# The ML service reads .env automatically; for Spring Boot and the ETL, export the
# variables in the shell / IDE run configuration.
# ==============================================================================

# Database Configuration (Microsoft SQL Server - dbDWH)
DB_HOST=localhost
DB_NAME=dbDWH
DB_PORT=1433
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Spring Boot Backend
SERVER_PORT=8081
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost;databaseName=dbDWH;integratedSecurity=true;encrypt=false;trustServerCertificate=true
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
CACHE_TTL_MINUTES=10

# Security (JWT) - REQUIRED: random string of at least 32 characters
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# Passwords of the accounts created on first start (empty user table). Generated and logged if empty.
APP_ADMIN_PASSWORD=
APP_OPERATEUR_PASSWORD=

# Machine Learning Service (FastAPI) - only reachable through the backend
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
# Shared key between backend and ML service (header X-API-Key). Recommended.
ML_API_KEY=
ML_HISTORY_START=2024-01-01
ML_BACKTEST_ORIGINS=3

# Stock business rules (shared by backend and ML service)
STOCK_CONSO_WINDOW_DAYS=365
STOCK_RUPTURE_RECENT_DAYS=30
STOCK_CRITIQUE_DAYS=15
STOCK_SURSTOCK_DAYS=120
STOCK_COVERAGE_TARGET_DAYS=45

# ETL: cleaned tables are loaded into staging tables with this prefix (never the production tables)
ETL_TARGET_PREFIX=STG_

# Frontend (React)
REACT_APP_API_URL=http://localhost:8081/api
