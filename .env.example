# Database Configuration (Microsoft SQL Server 2022)
DB_HOST=LAPTOP-M7HILU4Q
DB_NAME=dbDWH
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_TRUSTED=yes
DB_DRIVER=ODBC Driver 17 for SQL Server

# Spring Boot Backend Configuration
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:sqlserver://${DB_HOST};databaseName=${DB_NAME};integratedSecurity=true;encrypt=false;trustServerCertificate=true

# Security & Authentication (JWT)
JWT_SECRET=PFEImenSecretKey2024VeryLongSecretKeyForJWTSigning1234567890ABCDEF
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Machine Learning Service (FastAPI)
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# Frontend Configuration (React 18)
REACT_APP_API_URL=http://localhost:8081/api
