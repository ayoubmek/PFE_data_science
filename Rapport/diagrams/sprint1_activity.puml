@startuml sprint1_activity
skinparam activity {
    BackgroundColor White
    BorderColor #2B3A4A
    FontName Arial
    FontSize 11
    ArrowColor #2B3A4A
}

start

:1. Ingestion des sources brutes\n* Extractions ERP atelier (PRODUCTION_RAW, ASTOCKDATE_RAW);

partition "2. Assainissement et Contrôle Qualité" {
    :Détection et suppression des doublons\n(Clé composite Date, Article, Emplacement);
    :Validation et normalisation des dates\n(Filtrage des formats erronés);
    :Harmonisation des types et séparateurs numériques;
    :Régularisation des coûts unitaires et stocks négatifs;
    :Gestion des valeurs manquantes et imputation;
}

partition "3. Structuration dimensionnelle" {
    :Génération des clés primaires et étrangères;
    :Alimentation des dimensions (MCMachineCenter);
    :Constitution des faits (FACT_CLE, ASTOCKDATE);
}

partition "4. Chargement dans le Data Warehouse" {
    :Insertion par lots dans Microsoft SQL Server;
    :Reconstruction et optimisation des index;
    :Génération du journal d'exécution et rapport d'audit;
}

stop
@enduml
