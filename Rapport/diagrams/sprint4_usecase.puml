@startuml sprint4_usecase
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

skinparam usecase {
    BackgroundColor White
    BorderColor #2B3A4A
    ArrowColor #2B3A4A
    FontSize 12
    FontName Arial
}
skinparam actor {
    BackgroundColor White
    BorderColor #2B3A4A
    FontColor #1E1E2D
    FontSize 12
    FontName Arial
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor White
    BorderColor #2B3A4A
    FontSize 14
    FontName Arial
    FontStyle bold
    FontColor #1E1E2D
}

actor "Administrateur" as ADM

rectangle "Module IA & Prévision Prophet" {
    usecase "S'authentifier" as UC_Auth
    usecase "Consulter les prévisions de production" as UC41
    usecase "Consulter les projections de stock" as UC42
    usecase "Visualiser les intervalles de confiance (95%)" as UC43
    usecase "Consulter les recommandations opérationnelles" as UC44
}

ADM --> UC41
ADM --> UC42
ADM --> UC43
ADM --> UC44

UC41 ..> UC_Auth : <<include>>
UC42 ..> UC_Auth : <<include>>
UC43 ..> UC_Auth : <<include>>
UC44 ..> UC_Auth : <<include>>
@enduml