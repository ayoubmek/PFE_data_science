%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Arial', 'fontSize': '12px'}}}%%
classDiagram
    direction TB

    class RoleEnum {
        <<enumeration>>
        ADMIN
        SERVICE_VENDEUR
        VENDEUR
        SERVICE_LOGISTIQUE
        SERVICE_CLIENT
        SERVICE_FINANCE
    }

    class Client {
        +bigint id
        +string nom
        +string email
        +string telephone
        +string adresse
    }

    class Utilisateur {
        +bigint id
        +string nom
        +string email
        +string mot_de_passe
        +RoleEnum role
    }


    class PipelineCommercial {
        +bigint id
        +string titre
        +string besoin
        +string solution_proposee
        +string statut
        +string priorite
        +timestamp date_creation
    }


    class Reclamation {
        +bigint id
        +string sujet
        +string description
        +string statut
        +string solution
        +timestamp date_creation
    }

    class DemandeApprobation {
        +bigint id
        +string type_demande
        +string statut
        +string donnees
        +string commentaire_admin
        +timestamp date_creation
    }


    class Commande {
        +bigint id
        +int numero_commande
        +string statut
        +decimal montant_total
    }

    class Produit {
        +bigint id
        +string sku
        +string nom
        +decimal prix
    }

    class Notification {
        +string id
        +string type
        +string donnees
        +timestamp lu_le
    }

    class LigneCommande {
        +bigint id
        +int quantite
        +decimal prix_unitaire
        +string sku
    }

    class Bordereau {
        +bigint id
        +int numero_bordereau
        +string statut
        +decimal frais_livraison
    }

    class Facture {
        +bigint id
        +string numero_facture
        +decimal montant_total
    }

    class Historique {
        +bigint id
        +string action
        +string description
        +string logs
        +timestamp date_creation
    }

    %% Relations
    Utilisateur -- RoleEnum : role
    Utilisateur "1" -- "*" Commande : logistique traite
    Utilisateur "1" -- "*" Produit : vendeur gère
    Utilisateur "1" -- "*" Notification : reçoit
    Utilisateur "1" -- "*" Historique : génère
    Utilisateur "1" -- "*" Reclamation : traite
    Utilisateur "1" -- "*" DemandeApprobation : envoie
    Utilisateur "1" -- "*" DemandeApprobation : traite
    Utilisateur "1" -- "*" PipelineCommercial : crée

    Client "1" -- "*" Commande : passe
    Client "1" -- "*" Reclamation : soumet
    Client "1" -- "0..*" PipelineCommercial : possède

    Commande "1" *-- "*" LigneCommande : contient
    Produit "*" <-- "1" Commande : concerne
    LigneCommande "*" -- "1..*" Bordereau : groupée dans
    Bordereau "*" -- "1" Facture : facturé via
    DemandeApprobation "*" -- "1" Commande : concerne
    DemandeApprobation "*" -- "1" Produit : concerne
    PipelineCommercial "1" -- "0..*" Commande : génère

